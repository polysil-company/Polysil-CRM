# ─────────────────────────────────────────────────────────────────────────────
# Polysil CRM — environment variables
#
# Copy to .env.local for local development. This file is committed:
# NEVER put a real secret in it. Deployed values live in the hosting platform.
# Full reference: Docs/Environments.md
# ─────────────────────────────────────────────────────────────────────────────

# Which environment this build is for: development | feature | staging | production
# Build-time (inlined into the bundle) — each environment needs its own build.
NEXT_PUBLIC_APP_ENV=development

# Backend REST API base URL, no trailing slash. An absolute URL, or a same-origin
# path such as /api/v1 when a rewrite proxies the backend. Required in staging/production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Mock Service Worker: enabled | disabled.
# Defaults to enabled in development/feature. The build FAILS if enabled in staging/production.
NEXT_PUBLIC_API_MOCKING=enabled

# Release identifier shown in logs and error references (e.g. the git SHA). Set by CI.
NEXT_PUBLIC_RELEASE=local

# Log level: debug | info | warn | error | silent
# Runtime (NOT inlined): change it on the host and restart — server AND browsers follow,
# no rebuild. Defaults: development/feature=debug, staging=info, production=warn.
LOG_LEVEL=debug
