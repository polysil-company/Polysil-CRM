# ─────────────────────────────────────────────────────────────────────────────
# Polysil CRM — environment variables
#
# Copy to .env.local for local development. This file is committed:
# NEVER put a real secret in it. Deployed values live in the hosting platform.
# Full reference: Docs/Environments.md
# ─────────────────────────────────────────────────────────────────────────────

# Which environment this build is for: development | feature | staging | production
# Build-time (inlined into the bundle) — each environment needs its own build.
NEXT_PUBLIC_APP_ENV=development

# Backend REST API base URL as the browser sees it, no trailing slash. Keep the default
# same-origin path: the backend sends no CORS headers and scopes its refresh cookie to
# /api/v1/auth, so the browser must reach it through this app. Required in staging/production.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Where the /api/v1 rewrite forwards to: the backend's own origin, no path.
# Server-side only, read at dev-server start and build time. Required in staging/production.
API_PROXY_TARGET=http://127.0.0.1:8000

# Mock Service Worker: enabled | partial | disabled.
#   enabled  every endpoint is mocked. The default in development/feature.
#   partial  only what the backend does not serve yet is mocked (unbuiltHandlers in
#            src/mocks/handlers/index.ts); sign-in and the rest go to API_PROXY_TARGET.
#   disabled nothing is mocked.
# The build FAILS if enabled or partial in staging/production.
NEXT_PUBLIC_API_MOCKING=enabled

# To build against the backend's shared dev API instead (real data; the password comes from
# the backend team and never goes in a file), use these two lines:
#   API_PROXY_TARGET=https://polysil-api.pranayx.tech
#   NEXT_PUBLIC_API_MOCKING=partial

# Release identifier shown in logs and error references (e.g. the git SHA). Set by CI.
NEXT_PUBLIC_RELEASE=local

# Log level: debug | info | warn | error | silent
# Runtime (NOT inlined): change it on the host and restart — server AND browsers follow,
# no rebuild. Defaults: development/feature=debug, staging=info, production=warn.
LOG_LEVEL=debug
