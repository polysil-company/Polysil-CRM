# The frontend on the staging box, at polysil-test.pranayx.tech (polysil.pranayx.tech
# until 16 Oct 2026; that record is gone). Applied by `deploy_staging.py frontend-caddy`,
# after:
#
#   1. An A record for polysil-test.pranayx.tech at Cloudflare, pointing at this box,
#      DNS only (grey cloud): Let's Encrypt must reach the box for HTTP-01.
#   2. `python scripts/deploy_staging.py frontend-provision`, so polysil-frontend
#      and polysil-deploy-hook exist on distributed-file-system_default.
#   3. `python scripts/deploy_staging.py frontend-caddy`: replaces the block below,
#      and removes any old polysil.pranayx.tech block,
#      in /home/opc/Distributed-File-System/Caddyfile, validates, reloads.
#
# Undo: remove the blocks and reload.
#
# One origin for the browser: the pages, the API and the webhook. The API goes
# straight to its container, so an upload does not pass through Next's rewrite,
# and the refresh cookie (path /api/v1/auth) is set on this host. Tabs, like the
# file on the box.

polysil-test.pranayx.tech {
	encode zstd gzip

	# FS-015 rule 10: the outer belt on complaint uploads
	request_body /api/v1/complaints/* {
		max_size 12MB
	}

	# FS-009: the same belt on subsidy documents
	request_body /api/v1/subsidy-applications/* {
		max_size 12MB
	}

	handle /api/v1/* {
		reverse_proxy polysil-api:8000
	}

	# the hook reads a body before it can check the signature; a push is small
	request_body /hooks/* {
		max_size 1MB
	}

	handle /hooks/* {
		reverse_proxy polysil-deploy-hook:9000
	}

	handle {
		reverse_proxy polysil-frontend:3000
	}
}
