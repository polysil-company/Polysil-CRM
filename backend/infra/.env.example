# Copy to infra/.env and fill in. infra/.env is gitignored - never commit it.

# ── which database ───────────────────────────────────────────────────────
# db-tunnel  = remote Postgres over SSH   (docker compose --profile tunnel)
# postgres   = throwaway local container  (docker compose --profile local)
DB_HOST=db-tunnel

DB_USER=appuser
DB_PASSWORD=
DB_NAME=appdb

# ── SSH tunnel, only needed when DB_HOST=db-tunnel ───────────────────────
SSH_HOST=
SSH_USER=opc
SSH_KEY_PATH=C:/Users/you/.ssh/your-key
REMOTE_PG_PORT=55432

# ── everything else reaches the database here, always ────────────────────
# Settings requires both of these and gives neither a default, so alembic and the
# app both refuse to start without them. Containers use pgbouncer:6432 instead of
# 127.0.0.1:6432 - see docker-compose.yml.
#
# asyncpg is the app's driver; env.py rewrites it to psycopg for migrations, so
# there is one line here rather than two that can disagree. The port must be
# PgBouncer's 6432 or Settings refuses it (ADR-023).
DATABASE_URL=postgresql+asyncpg://appuser:@127.0.0.1:6432/appdb

# Any long random string locally. Staging and production get their own.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Set only where a cluster admin has run:
#   CREATE ROLE app_anon NOLOGIN;  GRANT app_anon TO ${DB_USER};
# Unset means get_db_anon issues no SET LOCAL ROLE - see docs/gaps/auth.md GAP-021.
DB_ANON_ROLE=

# FS-002. The role every application transaction switches into. Defaults to
# app_role; the API refuses to start outside local if it is unset or missing.
#   CREATE ROLE app_role NOLOGIN;  GRANT app_role TO ${DB_USER};
DB_APP_ROLE=app_role
