# Copy to infra/.env.staging and fill in. infra/.env.staging is gitignored and
# holds real secrets - never commit it, and never copy values out of infra/.env.
#
# It is read twice: by scripts/deploy_staging.py on your machine (for the SSH
# section), and by docker compose on the box (for everything else). The deploy
# script uploads it to the box with mode 600.
#
#   python scripts/deploy_staging.py --help
#   docs/workflows/staging-deployment.md

# ── how the deploy script reaches the box ────────────────────────────────
SSH_HOST=
SSH_USER=opc
SSH_KEY_PATH=C:/Users/you/.ssh/your-key
# Where the source tree lands on the box. Created if missing.
REMOTE_DIR=/home/opc/polysil-crm

# ── the staging database ─────────────────────────────────────────────────
# A database of its own on the same PostgreSQL 16 the development database
# lives in, with a login role of its own. NOT appdb: that is the database we
# develop against, and the deploy script refuses to run if it is named here.
DB_NAME=appdb_staging
DB_USER=appstaging
DB_PASSWORD=

# How PgBouncer reaches PostgreSQL. The server publishes it on the host at
# 127.0.0.1:55432, which no container can reach, so PgBouncer joins the network
# the Postgres container is already on and addresses it by container name.
PG_HOST=rr-dogfood-db
PG_PORT=5432
PG_NETWORK=rr-dogfood-net

# Only used by `deploy_staging.py provision`, which creates the role and the
# database if they are missing. Socket auth inside the container, no password.
PG_CONTAINER=rr-dogfood-db
PG_SUPERUSER=rrdog

# ── the application ──────────────────────────────────────────────────────
# Its own secret. Do not reuse the one in infra/.env: that one is local-only,
# and a shared secret means a token minted on a laptop is valid on the box.
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Both are cluster-level NOLOGIN roles that must exist and be granted to
# DB_USER. `deploy_staging.py provision` issues the grants.
DB_ANON_ROLE=app_anon
DB_APP_ROLE=app_role

# mock logs the message and keeps the code in the outbox row, which is how the
# frontend track reads an OTP without a phone. 11za is the client's live
# account and needs WHATSAPP_AUTH_TOKEN; staging should stay on mock until
# someone decides real messages may leave this box.
WHATSAPP_PROVIDER=mock
WHATSAPP_AUTH_TOKEN=

# X-Forwarded-For is trusted for this many hops, and only when the immediate
# peer is loopback (api/routers/auth.py:_client_ip). A reverse proxy in another
# container is not loopback, so behind one this has no effect and every login
# and OTP rate-limit bucket collapses onto the proxy address. ISS-084.
TRUSTED_PROXY_HOPS=1

# ── ports published on the box, all bound to 127.0.0.1 ───────────────────
# Reached over an SSH tunnel. Nothing here is open to the internet.
API_HOST_PORT=8100
PGBOUNCER_HOST_PORT=6432

# ── the demo seed ────────────────────────────────────────────────────────
# The password every seeded user gets. The default is the one printed in
# scripts/seed_demo.py, which is in the repository and therefore public.
DEMO_PASSWORD=
